# Relay endpoints the web app talks to.
#
# Local development (single Vite server on :5173, relay on :8787) works with no
# env at all — relayConfig.js auto-detects localhost. Copy this file to
# `.env.local` only if you want to override those defaults.
#
# DEPLOYMENT (e.g. Vercel): you MUST set these to your own running relay, or
# session creation will fail ("Unable to reach the relay server"). They are
# baked in at build time, so set them in the Vercel project environment before
# building. Without them the build falls back to the production workers.dev relay.
VITE_RELAY_HTTP_URL=http://localhost:8787
VITE_RELAY_WS_URL=ws://localhost:8787

# Where the receiver/join page lives. Defaults to the current origin + /r, which
# is correct for both local dev and production. Override only for split hosting.
VITE_RECEIVER_BASE_URL=

# Optional TURN server for WebRTC across restrictive networks.
# Free defaults, no signup, no cost: public OpenRelay static-auth demo.
# Copy these as-is for default behavior, or override with your own TURN.
# NOTE: VITE_ vars bake into the client bundle, so custom TURN creds are
# visible to page viewers — same exposure class as hardcoded secrets.
VITE_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject
